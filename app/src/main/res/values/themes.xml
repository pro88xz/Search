<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme: neutral, no dynamic (Material You) tint. -->
    <style name="Theme.Search" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:colorBackground">@color/appBackground</item>
        <!--
          The light theme is drawn as it is. Android's light framework themes
          allow "force dark", and with the phone in dark mode Samsung's "Dark
          mode for apps" (and Android's Override force-dark) repaints any app
          that allows it - so a user who picked Light in Settings got a light
          theme the system darkened again, pages included: "can't switch to
          light mode". The app has a real dark theme (values-night) for when
          dark is wanted. Ignored below Android 10.
        -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <!-- The default accent (purple) until ThemeOverlay.Search.Accent.*
             puts the chosen one on top. Left unset, MaterialComponents gave
             switches and radio buttons its teal and dialog buttons its vivid
             #6200EE - neither the app's accent. -->
        <item name="colorPrimary">@color/accentPurple</item>
        <item name="colorPrimaryVariant">@color/accentPurple</item>
        <item name="colorSecondary">@color/accentPurple</item>
        <item name="colorAccent">@color/accentPurple</item>
        <item name="colorControlActivated">@color/accentPurple</item>
    </style>

    <!-- The accent picked in Settings > Customize, laid over Theme.Search by
         Settings.applyAccent in every screen. -->
    <style name="ThemeOverlay.Search.Accent" parent="">
        <item name="colorPrimary">@color/accentPurple</item>
        <item name="colorPrimaryVariant">@color/accentPurple</item>
        <item name="colorSecondary">@color/accentPurple</item>
        <item name="colorAccent">@color/accentPurple</item>
        <item name="colorControlActivated">@color/accentPurple</item>
    </style>
    <style name="ThemeOverlay.Search.Accent.Purple" />
    <style name="ThemeOverlay.Search.Accent.Blue">
        <item name="colorPrimary">@color/accentBlue</item>
        <item name="colorPrimaryVariant">@color/accentBlue</item>
        <item name="colorSecondary">@color/accentBlue</item>
        <item name="colorAccent">@color/accentBlue</item>
        <item name="colorControlActivated">@color/accentBlue</item>
    </style>
    <style name="ThemeOverlay.Search.Accent.Green">
        <item name="colorPrimary">@color/accentGreen</item>
        <item name="colorPrimaryVariant">@color/accentGreen</item>
        <item name="colorSecondary">@color/accentGreen</item>
        <item name="colorAccent">@color/accentGreen</item>
        <item name="colorControlActivated">@color/accentGreen</item>
    </style>
    <style name="ThemeOverlay.Search.Accent.Amber">
        <item name="colorPrimary">@color/accentAmber</item>
        <item name="colorPrimaryVariant">@color/accentAmber</item>
        <item name="colorSecondary">@color/accentAmber</item>
        <item name="colorAccent">@color/accentAmber</item>
        <item name="colorControlActivated">@color/accentAmber</item>
    </style>
    <style name="ThemeOverlay.Search.Accent.Rose">
        <item name="colorPrimary">@color/accentRose</item>
        <item name="colorPrimaryVariant">@color/accentRose</item>
        <item name="colorSecondary">@color/accentRose</item>
        <item name="colorAccent">@color/accentRose</item>
        <item name="colorControlActivated">@color/accentRose</item>
    </style>
    <style name="ThemeOverlay.Search.Accent.Ink">
        <item name="colorPrimary">@color/accentInk</item>
        <item name="colorPrimaryVariant">@color/accentInk</item>
        <item name="colorSecondary">@color/accentInk</item>
        <item name="colorAccent">@color/accentInk</item>
        <item name="colorControlActivated">@color/accentInk</item>
    </style>
    <!--
      Dialogs.

      The text dialogs were built with android.app.AlertDialog - the FRAMEWORK
      one, styled by the platform and deaf to anything the app's theme says.
      That is why they came up square-cornered against an app that rounds
      everything else: nothing was wrong with the styling, the dialog simply
      was not listening to it.

      MaterialAlertDialogBuilder does listen, and this overlay hands it the
      same radius_xl every other sheet in the app uses, so a dialog is
      recognisably the same object as the menu it came from.

      The four dialogs built from custom layouts are untouched - they already
      draw their own dialog_bg and set the window transparent.
    -->
    <style name="ShapeAppearance.Search.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>
    <style name="Theme.Search.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Search.Dialog</item>
    </style>

    <style name="Theme.Search.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
