<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The page BEHIND the suggestions - deliberately the darker of the
         two now. It was #FAFAFA against rows of #F0F0F3, four percent apart,
         so the rows had nothing to sit on and the whole sheet read as one
         flat plane. -->
    <color name="searchPageBg">#F5F5F5</color>
    <color name="appBackground">#F5F5F5</color>
    <!-- Search suggestions -->
    <color name="sugMuted">#8A8A8A</color>
    <!-- White, so each row lifts off the page. The 12dp radius was always
         there; it just had no contrast to show it. -->
    <!-- Chip fill and chip text. A chip sits INSIDE the white row surface, so
         it has to be the darker of the two or it disappears - the opposite
         relationship to the row, which sits on the page. -->
    <color name="sugChipBg">#EAEAEA</color>
    <color name="sugFg">#17171C</color>
    <color name="sugCard">#00FFFFFF</color>
    <color name="sugIcon">#6E6E73</color>
    <color name="fieldSurface">#FFFFFF</color>
    <color name="cardLine">#E4E4E7</color>
    <!-- Mirrors the home page card fill and text colour -->
    <color name="feedCard">#FFFFFF</color>
    <!-- home.html's secondary text and card hairline, for the native feed ad card. -->
    <color name="feedMuted">#45434F</color>
    <color name="feedHair">#14161428</color>
    <color name="feedFg">#0E0E10</color>
    <!-- Settings surfaces: the same page and card colours as every other
         screen (appBackground under white cards). The page was a lavender
         #F1EEF7, a purple tint no other screen had. -->
    <color name="settingsPageBg">#F5F5F5</color>
    <color name="settingsCard">#FFFFFF</color>
    <color name="settingsIconTint">#5E44A0</color>
    <!-- The splash in light mode; values-night has the dark one. -->
    <color name="splashBg">#FFFFFF</color>
    <color name="ic_launcher_background">#2A1E48</color>
    <color name="sugSheet">#FFFFFF</color>
    <color name="sugTitle">#7D7D7D</color>
    <color name="dangerFg">#B3261E</color>
    <!-- Bottom bar and top bar glyphs at rest: a neutral grey (it was a
         purple grey). Selected Home takes the accent. -->
    <color name="navIcon">#5F6368</color>
    <!-- The bottom bar's sheet. -->
    <color name="barSurface">#FFFFFF</color>
    <!-- The accent picked in Settings > Customize, as ink: deep enough to
         read on a white surface (values-night has the light ones for dark
         surfaces). Switches, radio buttons, dialog buttons, the settings icons
         and their section labels all take it (ThemeOverlay.Search.Accent.*),
         so every screen carries the one accent the user chose. -->
    <color name="accentBlue">#2B6CF0</color>
    <color name="accentPurple">#5E44A0</color>
    <color name="accentGreen">#1E8E55</color>
    <color name="accentAmber">#A86400</color>
    <color name="accentRose">#C4304B</color>
    <color name="accentInk">#0E0E10</color>
    <!-- The tile behind the launcher shortcuts' glyphs. -->
    <color name="shortcutTile">#FFFFFF</color>
    <!-- The home-screen search widget. -->
    <color name="widgetPill">#FFFFFF</color>
    <color name="widgetLine">#1F000000</color>
    <color name="widgetHint">#5F6368</color>
    <color name="widgetPress">#14000000</color>
    <color name="widgetShadow">#1A000000</color>
</resources>
