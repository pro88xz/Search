<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The page BEHIND the suggestions - deliberately the darker of the
         two now. It was #FAFAFA against rows of #F0F0F3, four percent apart,
         so the rows had nothing to sit on and the whole sheet read as one
         flat plane. -->
    <color name="searchPageBg">#F5F5F5</color>
    <color name="appBackground">#F5F5F5</color>
    <!-- Search suggestions -->
    <color name="sugMuted">#8A8A8A</color>
    <!-- White, so each row lifts off the page. The 12dp radius was always
         there; it just had no contrast to show it. -->
    <!-- Chip fill and chip text. A chip sits INSIDE the white row surface, so
         it has to be the darker of the two or it disappears - the opposite
         relationship to the row, which sits on the page. -->
    <color name="sugChipBg">#EAEAEA</color>
    <color name="sugFg">#17171C</color>
    <color name="sugCard">#00FFFFFF</color>
    <color name="sugIcon">#6E6E73</color>
    <color name="fieldSurface">#FFFFFF</color>
    <color name="cardLine">#E4E4E7</color>
    <!-- Mirrors the home page card fill and text colour -->
    <color name="feedCard">#FFFFFF</color>
    <color name="feedFg">#0E0E10</color>
    <!-- Settings Material-3 surfaces -->
    <color name="settingsPageBg">#F1EEF7</color>
    <color name="settingsCard">#FFFFFF</color>
    <color name="settingsIconTint">#5E44A0</color>
    <color name="splashBg">#EAEAF0</color>
    <color name="ic_launcher_background">#2A1E48</color>
    <color name="sugSheet">#FFFFFF</color>
    <color name="sugTitle">#7D7D7D</color>
    <color name="dangerFg">#B3261E</color>
</resources>
