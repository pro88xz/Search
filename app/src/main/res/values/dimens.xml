<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DESIGN TOKENS: single source of truth for spacing, sizing, shape.
         Reference these instead of hard-coded numbers so the app stays in rhythm. -->

    <!-- SPACING SCALE (4dp grid): use for all padding and margins. -->
    <dimen name="space_xxs">4dp</dimen>
    <dimen name="space_xs">8dp</dimen>
    <dimen name="space_sm">12dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">20dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_2xl">32dp</dimen>
    <dimen name="space_3xl">40dp</dimen>

    <!-- CORNER RADIUS SCALE.

         This existed before and not one drawable referenced it - all fifteen
         hardcoded their own number, which is how the app ended up with nine
         different radii (4, 6, 10, 12, 16, 18, 20, 24, 25) and no two
         surfaces agreeing. That is what reads as homemade: a design language
         is a small set of decisions repeated, not a decision per file.

         The steps are also larger than they were. 12-16-20-24 is a 2018
         shape; the phones this ships on round their cards at 24-28 and their
         fields into pills, and a browser that does not looks a generation
         behind the launcher that opened it.

         radius_pill is deliberately absurd: Android clamps a corner radius to
         half the shorter side, so one value gives a true pill at any height.
         The address field changes height in three states and used a fixed
         25dp chosen for one of them. -->
    <dimen name="radius_xs">6dp</dimen>
    <dimen name="radius_sm">12dp</dimen>
    <dimen name="radius_md">18dp</dimen>
    <dimen name="radius_lg">24dp</dimen>
    <dimen name="radius_xl">28dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- TEXT SIZE SCALE: use for all textSize. -->
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_body_lg">15sp</dimen>
    <dimen name="text_title">18sp</dimen>
    <dimen name="text_headline">20sp</dimen>
    <dimen name="text_display">28sp</dimen>

    <!-- ICON SIZE SCALE: visual size of an icon inside its button. -->
    <dimen name="icon_sm">18dp</dimen>
    <dimen name="icon_md">22dp</dimen>
    <dimen name="icon_lg">24dp</dimen>

    <!-- TOUCH TARGET: minimum tappable size (accessibility). -->
    <dimen name="touch_target">48dp</dimen>
</resources>
