<?xml version="1.0" encoding="utf-8"?>
<!-- The Search button's icon: a search glass with a sparkle - a fresh
     search, which is what the button starts. In the other bar icons' style
     (Tabler outline: 24 grid, round caps and joins), with a 2.7 line, shown
     at 28dp: white on a coloured circle reads lighter than dark on white, and
     the centre button wants a little more presence than the icons beside
     it. Colour is applied by tint at runtime. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The glass. -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="2.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3.7,11.5a6.3,6.3 0,1 0,12.6 0a6.3,6.3 0,1 0,-12.6 0" />
    <!-- Its handle. -->
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="2.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M14.6,16.1L20.2,21.7" />
    <!-- The sparkle, a four-pointed star above the glass. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M18.6,1.6c0.35,2.05 1.15,2.85 3.2,3.2c-2.05,0.35 -2.85,1.15 -3.2,3.2c-0.35,-2.05 -1.15,-2.85 -3.2,-3.2c2.05,-0.35 2.85,-1.15 3.2,-3.2z" />
</vector>
