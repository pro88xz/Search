<?xml version="1.0" encoding="utf-8"?>
<!-- The tab-count badge. Filled with the accent at runtime via
     backgroundTintList; the ring is the window colour, which is what cuts the
     badge out from the owl - the default accent is purple and so is the owl,
     so without it the badge would all but disappear into the artwork. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#8B6BD8" />
    <stroke
        android:width="1.5dp"
        android:color="?android:attr/colorBackground" />
</shape>
