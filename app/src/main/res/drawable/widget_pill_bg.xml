<?xml version="1.0" encoding="utf-8"?>
<!-- The search widget's pill: the app's field colour, fully rounded, with a
     hairline so it holds its shape on any wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widgetPill" />
    <stroke android:width="1dp" android:color="@color/widgetLine" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
