<?xml version="1.0" encoding="utf-8"?>
<!-- The search widget's pill: the app's field colour, fully rounded, a
     hairline so it holds its shape on any wallpaper and a soft shadow under
     it so it sits on the wallpaper rather than being cut out of it; pressed,
     it dims a touch. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widgetPress">
    <item>
        <layer-list>
            <item android:top="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/widgetShadow" />
                    <corners android:radius="@dimen/radius_pill" />
                </shape>
            </item>
            <item android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/widgetPill" />
                    <stroke android:width="1dp" android:color="@color/widgetLine" />
                    <corners android:radius="@dimen/radius_pill" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
