<?xml version="1.0" encoding="utf-8"?>
<!-- The splash icon on Android 12+: the owl alone, no tile or circle behind
     it, on the splash background. Same artwork as the launcher icon, so the
     two never drift.

     How big it shows: Android draws a splash icon on a 108dp canvas and
     scales it to 192dp (a 160dp icon, x1.2 for one without a background).
     A plain drawable is laid out on that canvas 1.5x larger, as an adaptive
     icon's foreground is, so it starts on 162dp. The inset comes off that:
     14dp each side leaves 134dp, about 238dp on screen, which puts the owl
     (44% of the foreground's height) at about 105dp - the size the window
     before Android 12 shows it at (splash_window, 240dp). 24dp made it 89. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@mipmap/ic_launcher_foreground"
    android:inset="14dp" />
