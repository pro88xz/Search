<?xml version="1.0" encoding="utf-8"?>
<!-- The connection-state pill over the top of a loading page: the bars'
     surface, a hairline, fully rounded. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/barSurface" />
    <corners android:radius="@dimen/radius_pill" />
    <stroke android:width="1dp" android:color="@color/cardLine" />
</shape>
