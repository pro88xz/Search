<?xml version="1.0" encoding="utf-8"?>
<!-- Overflow. Three dots of radius 1.9 on a 24 grid, at y 5.6 / 12 / 18.4 -
     6.4 apart, so the spacing between them equals their own diameter plus a
     little, which is what stops three circles reading as one smear at 20dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path android:fillColor="@color/sugIcon"
        android:pathData="M 10.1,5.6 a 1.9,1.9 0 1,0 3.8,0 a 1.9,1.9 0 1,0 -3.8,0 Z" />
    <path android:fillColor="@color/sugIcon"
        android:pathData="M 10.1,12.0 a 1.9,1.9 0 1,0 3.8,0 a 1.9,1.9 0 1,0 -3.8,0 Z" />
    <path android:fillColor="@color/sugIcon"
        android:pathData="M 10.1,18.4 a 1.9,1.9 0 1,0 3.8,0 a 1.9,1.9 0 1,0 -3.8,0 Z" />
</vector>
