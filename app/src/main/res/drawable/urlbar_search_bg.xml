<?xml version="1.0" encoding="utf-8"?>
<!-- The field pinned to the top of the home page once its own search box has
     scrolled away: the same box - the home page's colour (fieldSurface is
     home.html's surface), fully rounded, no outline.
     No <padding> element here, so swapping this in never disturbs the text
     insets the EditText already carries. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/fieldSurface" />
    <corners android:radius="@dimen/radius_pill" />
</shape>
