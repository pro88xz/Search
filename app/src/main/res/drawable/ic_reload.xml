<?xml version="1.0" encoding="utf-8"?>
<!-- Reload: a closed two-tone ring with a dot at its centre.

     Exact geometry on a 24 grid centred at (12,12):
       outer radius 10.4, inner 6.8 - a wall of 3.6, drawn at 5.4dp
       dot radius 4.2, with 2.6 of clear grid around it
       the seam is one diagonal, split at 35 and 215 degrees, exactly opposite

     The wall is the whole design. Thicker than this and closing the ring
     gives a disc with a hole in it, because the opening drops below half the
     radius; at 3.6 the opening is two thirds and it reads as a ring while
     still carrying weight a thin stroke cannot.

     Two tones on purpose - the same pairing the settings icon uses, so the
     two read as one family. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- lower-left half of the ring -->
    <path
        android:fillColor="#5E44A0"
        android:pathData="M 20.519,17.965 A 10.40,10.40 0 0,1 3.481,6.035 L 6.430,8.100 A 6.80,6.80 0 0,0 17.570,15.900 Z" />
    <!-- upper-right half -->
    <path
        android:fillColor="#8B6BD8"
        android:pathData="M 3.481,6.035 A 10.40,10.40 0 0,1 20.519,17.965 L 17.570,15.900 A 6.80,6.80 0 0,0 6.430,8.100 Z" />
    <!-- the centre -->
    <path
        android:fillColor="#5E44A0"
        android:pathData="M 7.800,12.000 a 4.20,4.20 0 1,0 8.40,0 a 4.20,4.20 0 1,0 -8.40,0 Z" />
</vector>
