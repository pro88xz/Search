<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon.

  The icon used to be a flat 192x192 PNG with opaque corners. Every launcher
  since Android 8 handles one of those by supplying its own container and
  dropping the square inside it - the white squircle with a hard-edged purple
  tile in it, on every home screen and in every launch animation.

  Three layers instead:
    background  full-bleed gradient; only its centre 66% is ever shown, and it
                shifts under parallax during launcher animations
    foreground  the owl, scaled so the artwork - not its faint alpha halo -
                fills the 288x288 safe zone: 60x72dp on a 108dp canvas
    monochrome  the silhouette with the eyes and beak knocked out, for the
                themed icons introduced in Android 13. Without it this app is
                the one that stays full colour on a themed home screen.
                Older platforms ignore the tag.

  The legacy PNGs in mipmap-hdpi..xxxhdpi stay: minSdk is 24 and API 24-25
  have no adaptive icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
