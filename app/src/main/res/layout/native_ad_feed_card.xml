<?xml version="1.0" encoding="utf-8"?>
<!-- The feed ad, drawn as one more story on home's story card (.row in
     home.html): the picture or video the card's full width on top, the
     headline in the stories' 19sp medium type, and the publisher row's
     place taken by the advertiser - its icon, the required "Ad" label, its
     name - with the call to action at the end. MediaView is the full width
     (the SDK serves video from 120dp up). AdMob counts the views registered
     in MainActivity.bindFeedAd; the background behind them is not
     clickable, so a tap on empty space is never an ad click. -->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/adCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/ad_card_bg">

        <com.search.browser.AdMediaFrame
            android:id="@+id/adMediaFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/adMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.search.browser.AdMediaFrame>

        <TextView
            android:id="@+id/adHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:textSize="19sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/feedFg"
            android:lineSpacingMultiplier="1.12"
            android:letterSpacing="-0.008"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/adBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:textSize="14sp"
            android:textColor="@color/feedMuted"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/adIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/ad_icon_bg"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/adBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ad_badge_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Ad"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/adAdvertiser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/feedFg"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/adCta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minHeight="36dp"
                android:gravity="center"
                android:background="@drawable/ad_cta_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:maxWidth="160dp"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
