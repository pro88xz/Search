<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_bg">

    <!-- Owl brand icon -->
    <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_owl"
        android:layout_marginBottom="10dp"
        android:contentDescription="Search" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Download requested"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="8dp" />

    <!-- Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Did you start this download?"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="#8A8A8F"
        android:layout_marginBottom="4dp" />

    <!-- Filename -->
    <TextView
        android:id="@+id/dlFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="middle"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="4dp" />

    <!-- Size, where it goes, and the space left: "12.4 MB · to Downloads ·
         3.1 GB free". Filled from code (MainActivity.startDownload). -->
    <TextView
        android:id="@+id/dlSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:gravity="center"
        android:textColor="#8A8A8F"
        android:layout_marginBottom="18dp" />

    <!-- Shown when the file would take most of the free space. -->
    <TextView
        android:id="@+id/dlSpaceWarn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:gravity="center"
        android:textColor="@color/dangerFg"
        android:layout_marginBottom="18dp"
        android:visibility="gone" />

    <!-- Buttons row: clean left/right split -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/dlCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="No, cancel"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#E53935"
            android:background="@drawable/dialog_btn_outline" />

        <TextView
            android:id="@+id/dlConfirm"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Yes, it was me"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:background="@drawable/dialog_btn_filled" />
    </LinearLayout>
</LinearLayout>
