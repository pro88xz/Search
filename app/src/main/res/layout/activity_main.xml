<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Browser layer ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== TOP navigation bar ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_xxs"
            android:paddingEnd="@dimen/space_xxs"
            android:background="?android:attr/colorBackground">

            <ImageButton
                android:id="@+id/homeBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_owl"
                android:scaleType="fitCenter"
                android:padding="1dp"
                android:contentDescription="Home" />

            <TextView
                android:id="@+id/nightOwlBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Night Owl"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:paddingTop="@dimen/space_xxs"
                android:paddingBottom="@dimen/space_xxs"
                android:background="@drawable/nightowl_badge_bg"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/urlBarContainer"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_xxs"
                android:layout_marginEnd="@dimen/space_xxs">

                <EditText
                    android:id="@+id/urlBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Search"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="38dp"
                    android:textSize="15sp"
                    android:background="@drawable/urlbar_bg" />

                <ImageButton
                    android:id="@+id/starBtn"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_star_outline"
                    android:scaleType="fitCenter"
                    android:padding="5dp"
                    android:contentDescription="Bookmark" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/reloadBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="Reload" />

            <TextView
                android:id="@+id/tabCountBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tabs" />

            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:scaleType="fitCenter"
                android:padding="5dp"
                android:contentDescription="Settings" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ===== Tab deck overlay (hidden by default) ===== -->
    <LinearLayout
        android:id="@+id/tabDeck"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/deckSearch"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="Search or open a new tab"
                android:imeOptions="actionGo"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="15sp"
                android:background="@drawable/urlbar_bg" />



            <TextView
                android:id="@+id/deckNewTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ New"
                android:textStyle="bold"
                android:textColor="#2B6CF0"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/deckClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done"
                android:textStyle="bold"
                android:textColor="#2B6CF0"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bookmarkList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="54dp"
        android:background="?android:attr/colorBackground"
        android:visibility="gone" />

    <!-- ===== Slide-in menu panel (hidden by default) ===== -->
    <FrameLayout
        android:id="@+id/menuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/menuPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="220dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:background="@drawable/menu_bg"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:elevation="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingStart="20dp"
                android:paddingBottom="6dp" />

            <LinearLayout android:id="@+id/menuNewTab" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_newtab" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="New tab" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuNightOwl" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_nightowl" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Night Owl" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuDesktop" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_desktop" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Desktop mode" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuHistory" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_history" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="History" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuBookmarks" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_bookmarks" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Bookmarks" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuDownloads" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_downloads" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Downloads" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuFind" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_find" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Find in page" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuSupport" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_coffee" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Buy me a coffee" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuGames" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_games" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Play games" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuSettings" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_settings" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Settings" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Find-in-page bar (overlay, top) ===== -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="@dimen/space_xxs"
        android:background="?android:attr/colorBackground"
        android:elevation="8dp"
        android:visibility="gone">
        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Find in page"
            android:textSize="16sp"
            android:background="@null"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1" />
        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:layout_marginEnd="8dp"
            android:textColor="?android:attr/textColorSecondary" />
        <ImageButton
            android:id="@+id/findPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/arrow_up_float"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous match" />
        <ImageButton
            android:id="@+id/findNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/arrow_down_float"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next match" />
        <ImageButton
            android:id="@+id/findClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close find" />
    </LinearLayout>

</FrameLayout>
