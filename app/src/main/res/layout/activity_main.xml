<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Browser layer. clipChildren off so the bottom bar's raised
         New tab button can draw over the bottom of the page. ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false">

        <!-- ===== TOP navigation bar ===== -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:paddingStart="@dimen/space_xxs"
            android:paddingEnd="@dimen/space_xxs"
            android:background="?android:attr/colorBackground">

            <FrameLayout
                android:id="@+id/owlWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <!-- The owl is the brand mark. The menu it used to open is on
                     the bottom bar now, and the tab count with it. -->
                <ImageView
                    android:id="@+id/homeBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_owl"
                    android:scaleType="fitCenter"
                    android:padding="1dp"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/nightOwlBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Night Owl"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:paddingTop="@dimen/space_xxs"
                android:paddingBottom="@dimen/space_xxs"
                android:background="@drawable/nightowl_badge_bg"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/urlBarContainer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_xxs"
                android:layout_marginEnd="@dimen/space_xxs">

                <EditText
                    android:id="@+id/urlBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Search"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="38dp"
                    android:textSize="15sp"
                    android:background="@drawable/urlbar_bg" />

                <ImageButton
                    android:id="@+id/starBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_star_outline"
                    android:scaleType="fitCenter"
                    android:padding="14dp"
                    android:contentDescription="Bookmark" />

                <ImageButton
                    android:id="@+id/clearBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="7dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_clear"
                    android:scaleType="fitCenter"
                    android:padding="14dp"
                    android:visibility="gone"
                    android:contentDescription="Clear" />

                <LinearLayout
                    android:id="@+id/searchActions"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/micBtn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_mic"
                        android:scaleType="fitCenter"
                        android:padding="13dp"
                        android:contentDescription="Voice search" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@color/cardLine" />

                    <ImageButton
                        android:id="@+id/scanBtn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_scan"
                        android:scaleType="fitCenter"
                        android:padding="13dp"
                        android:contentDescription="Scan" />
                </LinearLayout>
            </FrameLayout>

            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:background="@drawable/nav_ripple"
                android:src="@drawable/nav_settings"
                android:scaleType="center"
                android:contentDescription="Settings" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/webArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/webContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Over the top edge of the page rather than above it, so a load
                 starting or finishing never moves the page by its height, and
                 it stays at the top of the page while the bars are away. -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <!-- ===== Native feed ad. 14dp gutters match .wrap in home.html,
                 so the card lines up with the feed cards above it. Hidden
                 until one loads. Inside the page's own frame, so it is
                 positioned against the bottom of the page and clipped there,
                 and can never ride over the bottom bar. -->
            <com.search.browser.AdSlotLayout
                android:id="@+id/adSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="68dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- ===== BOTTOM navigation bar: Home, Bookmarks, New tab, Tabs, Menu.
             Icons only; each carries its name as a content description and a
             long-press tooltip. The frame is taller than the bar and pulled up
             58dp over the bottom of the page: 30dp of see-through strip above
             the bar's straight edge, where the arc and the New tab button rise,
             and the 28dp of its rounded corners, so the page shows behind the
             corners instead of a white block. The strip passes touches to the
             page. The ad slot's 68dp bottom margin and home.html's bottom
             padding allow for the same 58dp. ===== -->
        <FrameLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="-58dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- The bar's surface, drawn: the top edge rises in an arc around
                 the New tab button. Its straight edge is 30dp down, where the
                 62dp row of buttons below starts. -->
            <com.search.browser.NavSheetView
                android:id="@+id/navSheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/bottomSheet"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/navHome"
                    style="@style/NavSlot"
                    android:contentDescription="Home">

                    <ImageView
                        android:id="@+id/navHomeIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/nav_home"
                        android:importantForAccessibility="no" />

                    <!-- Marks Home as the page showing, under the icon. -->
                    <View
                        android:id="@+id/navHomeDot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_gravity="center"
                        android:translationY="18dp"
                        android:background="@drawable/nav_dot"
                        android:visibility="invisible"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/navBookmarks"
                    style="@style/NavButton"
                    android:src="@drawable/nav_bookmark"
                    android:contentDescription="Bookmarks" />

                <!-- Room for the New tab button, which sits in the arc. -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15" />

                <FrameLayout
                    android:id="@+id/navTabs"
                    style="@style/NavSlot"
                    android:contentDescription="Tabs">

                    <ImageView
                        android:id="@+id/navTabsIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/nav_tabs"
                        android:importantForAccessibility="no" />

                    <!-- The open-tab count, a badge on the back card's corner. -->
                    <TextView
                        android:id="@+id/navTabsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:translationX="12dp"
                        android:translationY="-11dp"
                        android:minWidth="18dp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="1"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/nav_badge_bg"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/navMenu"
                    style="@style/NavButton"
                    android:src="@drawable/nav_menu"
                    android:contentDescription="Menu" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/navNewTab"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="22dp"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/nav_ripple"
                android:contentDescription="New tab">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/nav_plus"
                    android:tint="#FFFFFF"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ===== Tab deck overlay (hidden by default) ===== -->
    <LinearLayout
        android:id="@+id/tabDeck"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/deckSearch"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="Search or open a new tab"
                android:imeOptions="actionGo"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="15sp"
                android:background="@drawable/urlbar_bg" />


            <TextView
                android:id="@+id/deckNewTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ New"
                android:textStyle="bold"
                android:textColor="#2B6CF0"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/deckClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done"
                android:textStyle="bold"
                android:textColor="#2B6CF0"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bookmarkList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/downloadList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/deckEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="@dimen/space_2xl"
            android:paddingEnd="@dimen/space_2xl"
            android:visibility="gone">
            <ImageView
                android:id="@+id/deckEmptyIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.35"
                android:layout_marginBottom="@dimen/space_md"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/deckEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="@dimen/space_xs" />
            <TextView
                android:id="@+id/deckEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body_lg"
                android:textColor="#8A8A8F"
                android:gravity="center"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- The search results, as two surfaces rather than one.

         The backdrop is the page; the RecyclerView is a card on it. Before
         this the list WAS the page - one flat expanse the same colour as the
         box above it, which is why it read as unfinished beside a browser
         that does this properly.

         clickable on the backdrop is not decoration: it is match_parent over
         the WebView, and without it a tap on the empty area goes straight
         through to whatever page is behind. -->
    <FrameLayout
        android:id="@+id/suggestBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="58dp"
        android:background="@color/searchPageBg"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <!-- wrap_content, so the card is the height of its results. Three
             suggestions give a short card with page showing under it; a full
             list grows until it runs out of backdrop and then scrolls inside
             itself. A match_parent card would just be a white screen with a
             few rows at the top of it. -->
        <!-- The card is this column now, not the list. The heading has to
             sit above the rows and stay there while they scroll, which a
             list item cannot do - and a heading built into the chips row
             would vanish the moment a query returns sites instead of
             searches. -->
        <LinearLayout
            android:id="@+id/suggestCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_sm"
            android:orientation="vertical"
            android:background="@drawable/sug_sheet_bg">

            <TextView
                android:id="@+id/suggestTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xxs"
                android:text="@string/suggest_title"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sugTitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/suggestOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/space_xs"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Slide-in menu panel (hidden by default) ===== -->
    <FrameLayout
        android:id="@+id/menuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/menuPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="220dp"
            android:layout_gravity="bottom|end"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="70dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:background="@drawable/menu_bg"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:elevation="12dp">

            <!-- Back, Forward and Reload, as the first row of Chrome's menu
                 does. They left the bottom bar for New tab and Bookmarks. -->
            <LinearLayout
                android:id="@+id/menuNavRow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageButton
                    android:id="@+id/menuBack"
                    style="@style/NavButton"
                    android:src="@drawable/menu_back"
                    android:contentDescription="Back" />

                <ImageButton
                    android:id="@+id/menuForward"
                    style="@style/NavButton"
                    android:src="@drawable/menu_forward"
                    android:contentDescription="Forward" />

                <ImageButton
                    android:id="@+id/menuRefresh"
                    style="@style/NavButton"
                    android:src="@drawable/menu_refresh"
                    android:contentDescription="Reload" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="4dp"
                android:background="@color/cardLine" />

            <!-- The rows scroll, so a short screen, landscape or a large font
                 never cuts any of them off: the panel is held between its top
                 and bottom margins and this takes what is left. -->
            <ScrollView
                android:id="@+id/menuScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menuRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout android:id="@+id/menuHome" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_home" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Take me home" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuNewTab" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_newtab" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="New tab" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuNightOwl" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_nightowl" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Night Owl" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuDesktop" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_desktop" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Desktop mode" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuHistory" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_history" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="History" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuDownloads" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_downloads" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Downloads" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuFind" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_find" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Find in page" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuSupport" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_coffee" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Buy me a coffee" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/menuGames" style="@style/MenuRow">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_games" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Play games" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            <!-- Debug builds only: shown from setupToolbar. -->
            <LinearLayout android:id="@+id/menuDebugLog" style="@style/MenuRow"
                android:visibility="gone">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/menu_find" android:layout_marginEnd="18dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Share debug log" android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
            </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Find-in-page bar (overlay, top) ===== -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="@dimen/space_xxs"
        android:background="?android:attr/colorBackground"
        android:elevation="8dp"
        android:visibility="gone">
        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Find in page"
            android:textSize="16sp"
            android:background="@null"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1" />
        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:layout_marginEnd="8dp"
            android:textColor="?android:attr/textColorSecondary" />
        <ImageButton
            android:id="@+id/findPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/arrow_up_float"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous match" />
        <ImageButton
            android:id="@+id/findNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/arrow_down_float"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next match" />
        <ImageButton
            android:id="@+id/findClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close find" />
    </LinearLayout>

</FrameLayout>
