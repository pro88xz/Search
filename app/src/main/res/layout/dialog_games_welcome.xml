<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_bg">
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_owl"
        android:layout_marginBottom="12dp"
        android:contentDescription="Search" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play Games"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="10dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jump into hundreds of free games — puzzles, arcade, action and more. No downloads, no sign-up. They open right here and play instantly."
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="#8A8A8F"
        android:layout_marginBottom="20dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/gamesLater"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Maybe later"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#5E44A0"
            android:background="@drawable/dialog_btn_outline" />
        <TextView
            android:id="@+id/gamesGo"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Let's go"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:background="@drawable/dialog_btn_filled" />
    </LinearLayout>
</LinearLayout>
