<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen search widget (SearchWidget): the owl, a pill that opens
     search, voice and the QR scanner. RemoteViews: only frame, linear,
     image and text views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetPill"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="6dp"
    android:background="@drawable/widget_pill_bg">

    <ImageView
        android:id="@+id/widgetOwl"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_owl"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widgetText"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical"
        android:text="@string/widget_hint"
        android:textSize="16sp"
        android:textColor="@color/widgetHint"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/widgetMic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="11dp"
        android:src="@drawable/ic_mic"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_voice" />

    <ImageView
        android:id="@+id/widgetScan"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="11dp"
        android:src="@drawable/ic_scan"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_scan" />
</LinearLayout>
