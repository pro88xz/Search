<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Search.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/splashBg</item>
        <!--
          No icon background (windowSplashScreenIconBackgroundColor): the owl
          sits straight on the splash's white, with nothing behind it.
        -->
        <!--
          The owl alone, on white: no tile, circle or gradient behind it.

          Left unset, the platform put the launcher icon on the splash - the
          owl inside its purple gradient - so it sat in a box. splash_owl is
          the same artwork (the launcher icon's foreground), so the two cannot
          drift apart, sized to match the owl the old splash showed.

          values-night-v31 repeats this style for dark mode, which would
          otherwise take values-night's and lose the icon. Keep the two in step.
        -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_owl</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
