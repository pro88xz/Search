<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcut icon (res/xml/shortcuts.xml): the menu glyph on a
     white adaptive tile, inside the safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcutTile" />
    <foreground>
        <inset android:drawable="@drawable/menu_newtab" android:inset="32%" />
    </foreground>
</adaptive-icon>
