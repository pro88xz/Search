<?xml version="1.0" encoding="utf-8"?>
<!--
  The splash for dark mode on Android 12 and up.

  Android ranks the night qualifier above the platform version, so on a dark
  phone values-night's Theme.Search.Splash beat values-v31's - and that one
  sets no splash icon, so the system fell back to the launcher icon and the
  owl sat in its purple box again. This file matches both, so it wins, and
  it is the same splash as values-v31: the owl alone, no box, on splashBg -
  which in dark mode is the app's dark background (values-night/colors.xml).
  Keep the two in step.
-->
<resources>
    <style name="Theme.Search.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/splashBg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_owl</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
