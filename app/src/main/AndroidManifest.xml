<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--
      Needed for the web to reach them at all. A site asking for the camera,
      the microphone or a location gets nothing unless this app itself holds
      the matching permission, which is why those features never worked: the
      request was granted at the WebView and then refused by the system.
      None is requested up front - each is asked for only when a site asks and
      the user has agreed to that site. Declared as optional hardware so a
      phone without a camera can still install the browser.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Search"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Search">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Search.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open web links tapped in other apps; required to be offered as a browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Receive shared text/links from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Search" />

        <activity
            android:name=".SectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Search" />
        <activity
            android:name=".LegalActivity"
            android:exported="false"
            android:theme="@style/Theme.Search" />
        <activity
            android:name=".SupportActivity"
            android:exported="false"
            android:theme="@style/Theme.Search" />
        <!--
          The intent-filter is what stops MediaButtonReceiver crashing.
          Its onReceive looks for a service declaring MEDIA_BUTTON, then for a
          media browser service, and throws IllegalStateException when it finds
          neither. There was no filter anywhere but on the receiver itself, so
          every play/pause tap on the media notification threw.
        -->
        <service
            android:name=".MediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>
        <!--
          The system delivers MEDIA_BUTTON from another process, so a receiver
          that is not exported never hears a headset or Bluetooth play/pause.
          Notification buttons worked because a PendingIntent carries this
          app's own identity; the hardware ones did not.
        -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>


        <!--
          Hands a downloaded file to another app as a content:// URI that app is
          allowed to read. Passing a raw file:// URI across apps has thrown
          FileUriExposedException since Android 7, which is why opening a
          download never worked on any file type.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9121922395304175~5269303770" />
    </application>
</manifest>
