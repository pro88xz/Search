{
  "name": "Search Android (JDK 17)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installGradle": false,
      "installMaven": false
    },
    "ghcr.io/devcontainers-extra/features/android-sdk:1": {}
  },
  "remoteEnv": {
    "JAVA_HOME": "/usr/local/sdkman/candidates/java/current"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "mathiasfrohlich.Kotlin"
      ]
    }
  },
  "postCreateCommand": "echo 'sdk.dir='$ANDROID_HOME > local.properties || true"
}
